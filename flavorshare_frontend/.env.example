# FlavorShare Frontend - Environment Variables (React CRA)
# Copy this file to .env and fill in the values.
# Note: CRA only exposes variables prefixed with REACT_APP_

# Supabase configuration (REQUIRED)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=

# App URLs (Recommended)
# Used for email redirect on sign-up and links in emails
REACT_APP_FRONTEND_URL=http://localhost:3000

# Backend/API base (optional if using Supabase directly)
REACT_APP_API_BASE=

# Runtime/Build toggles
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true

# Dev server configuration
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/healthz

# Feature flags and experiments (JSON or string flags as needed)
# Example: {"newSearch": true}
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false

# WebSocket URL if applicable (optional)
REACT_APP_WS_URL=
# Backend URL if applicable (optional)
REACT_APP_BACKEND_URL=
