# PUBLIC_INTERFACE
# Copy this file to ".env" and set values as needed. Do NOT commit real secrets.

# React requires variables to start with REACT_APP_ prefix to be exposed to the client
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=

# Backend API base (if used by the app)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Node environment hint (optional)
REACT_APP_NODE_ENV=development

# Disable Next telemetry placeholder (for consistency across stacks; not used by CRA)
REACT_APP_NEXT_TELEMETRY_DISABLED=true

# Enable source maps in dev (CRA defaults handle this; optional)
REACT_APP_ENABLE_SOURCE_MAPS=true

# Port to run the dev server on; used by scripts/set-port.js
REACT_APP_PORT=3000

# Trust proxy flag (not used by CRA, for parity)
REACT_APP_TRUST_PROXY=false

# Logging level (app-specific)
REACT_APP_LOG_LEVEL=info

# Healthcheck path (app-specific)
REACT_APP_HEALTHCHECK_PATH=/healthz

# Feature flags (comma-separated or JSON as your app expects)
REACT_APP_FEATURE_FLAGS=

# Experiments toggle (app-specific)
REACT_APP_EXPERIMENTS_ENABLED=false
