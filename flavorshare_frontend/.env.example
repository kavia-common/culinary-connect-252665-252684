# PUBLIC_INTERFACE
# Example environment configuration for FlavorShare frontend

# Dev server host/port
HOST=0.0.0.0
REACT_APP_PORT=3000

# Node environment
REACT_APP_NODE_ENV=development

# App URLs (set by orchestrator)
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_API_BASE=/api
REACT_APP_WS_URL=ws://localhost:8000

# Supabase (do not commit real values)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=

# Flags/telemetry
REACT_APP_NEXT_TELEMETRY_DISABLED=true
REACT_APP_ENABLE_SOURCE_MAPS=true

# Logging and health
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/healthz

# Feature flags (JSON string)
REACT_APP_FEATURE_FLAGS={}
REACT_APP_EXPERIMENTS_ENABLED=false
