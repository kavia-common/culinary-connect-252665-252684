# Frontend environment variables
# Copy this file to .env and fill your values. Do NOT commit real secrets.

# PUBLIC_INTERFACE
# Supabase configuration (required)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=

# PUBLIC_INTERFACE
# Optional: Used for email redirect after sign-up
REACT_APP_FRONTEND_URL=http://localhost:3000

# PUBLIC_INTERFACE
# Backend API base URL (if you expose any REST endpoints)
# http.get('/recipes') would call ${REACT_APP_API_BASE}/recipes
REACT_APP_API_BASE=
# Alternative name supported by api.js (if you prefer this env)
REACT_APP_BACKEND_URL=

# Dev server port (optional)
REACT_APP_PORT=3000
